# Claude Codex Monitor - example environment file
# Copy to .env if you want to override defaults. All settings also
# configurable at runtime via Settings UI / PATCH /api/settings.

# Port for the single-process dashboard (backend serves API + built frontend)
CCM_PORT=8787

# Data directory override (default: %LOCALAPPDATA%\ClaudeCodexMonitor)
# CCM_DATA_DIR=C:\path\to\custom\data\dir

# Display timezone (IANA name; default Asia/Dhaka)
CCM_DISPLAY_TZ=Asia/Dhaka

# Auto-refresh interval in seconds (default 300)
CCM_REFRESH_INTERVAL_SECONDS=300

# Set to 1 to use fake/stubbed adapters instead of touching real ~/.claude,
# ~/.codex or spawning codex.exe. Used by e2e tests. Never set this in normal use.
# CLAUDE_CODEX_MONITOR_FAKE_ADAPTERS=1
